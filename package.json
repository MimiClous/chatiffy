{
  "name": "chatiffy",
  "version": "1.7.1",
  "private": true,
  "type": "module",
  "description": "Customizable Twitch chat overlay for OBS with 7TV emotes and Twitch badges",
  "scripts": {
    "start": "node server.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "check": "node scripts/version.mjs check && pnpm run typecheck && node --check server.mjs",
    "pretest": "pnpm run build",
    "test": "node --test test.mjs typography.test.mjs tests/*.test.mjs",
    "build:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-windows.ps1",
    "test:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-windows.ps1",
    "dev:menu": "node scripts/dev-menu.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0"
  },
  "packageManager": "pnpm@11.25.0"
}
